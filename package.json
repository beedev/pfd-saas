{
  "name": "pfd-saas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:9999": "next dev --turbopack -p 9999",
    "prebuild": "node scripts/compute-schema-hash.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "predev": "node scripts/db-verify.mjs",
    "db:verify": "node scripts/db-verify.mjs",
    "smoke:tax": "node scripts/smoke-test-tax.mjs",
    "desktop:build": "next build && node electron/stage-standalone.mjs",
    "desktop": "electron electron/main.js",
    "desktop:dev": "npm run desktop:build && npm run desktop",
    "desktop:smoke": "node scripts/desktop-smoke.mjs",
    "dist:mac": "npm run desktop:build && electron-builder --mac"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.2",
    "@dxp/ui": "file:../dxp/packages/ui",
    "@electric-sql/pglite": "^0.5.5",
    "@electric-sql/pglite-socket": "^0.2.8",
    "@electric-sql/pglite-tools": "^0.4.5",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-pdf/renderer": "^4.3.2",
    "@tanstack/react-table": "^8.21.3",
    "better-sqlite3": "^12.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "jszip": "^3.10.1",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^0.562.0",
    "next": "16.2.9",
    "next-auth": "5.0.0-beta.31",
    "next-themes": "^0.4.6",
    "nodemailer": "7.0.13",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^5.6.205",
    "postgres": "3.4.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.69.0",
    "recharts": "^3.6.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "xirr": "^1.1.0",
    "zod": "^4.3.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "description": "A generic personal finance planner for India. SaaS edition.",
  "main": "electron/main.js",
  "build": {
    "appId": "com.bharath.artha",
    "productName": "Artha",
    "asar": false,
    "directories": {
      "output": "electron-dist"
    },
    "files": [
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "drizzle",
        "to": "drizzle"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "identity": null
    },
    "dmg": {
      "window": {
        "width": 600,
        "height": 460
      },
      "contents": [
        {
          "x": 150,
          "y": 170
        },
        {
          "x": 450,
          "y": 170,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 150,
          "y": 340,
          "path": "build/Install Artha.command"
        },
        {
          "x": 450,
          "y": 340,
          "path": "README-DESKTOP.md"
        }
      ]
    },
    "npmRebuild": false,
    "afterPack": "electron/after-pack.js"
  }
}
